# Local environment, editor state, and Python/Jupyter caches
.venv/
.vscode/*
!.vscode/settings.json
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.jupyter/

# Credentials
.env
.env.*
!.env.example
kaggle.json
*credentials*.json
*.pem
*.key

# Competition data and derived data (retain directory placeholders)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# Model weights; small figures/metrics are intentionally eligible for Git
outputs/models/*
!outputs/models/.gitkeep
*.pt
*.pth
*.onnx
*.ckpt
*.safetensors
*.h5
*.hdf5

# OS files
Thumbs.db
.DS_Store
