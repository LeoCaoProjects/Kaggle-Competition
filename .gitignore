# Local environment, editor state, and Python/Jupyter caches
.venv/
.vscode/*
!.vscode/settings.json
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.jupyter/

# Credentials
.env
.env.*
!.env.example
kaggle.json
*credentials*.json
*.pem
*.key

# External images and unnecessary derived data; retain required audit/split metadata
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/class_mapping.json
!data/processed/split_manifest.csv
!data/processed/training_manifest.csv
enge707_train_cache/
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
outputs/transfer/
outputs/reproduction/

# Model weights; small figures/metrics are intentionally eligible for Git
outputs/models/*
*.pt
*.pth
*.onnx
*.ckpt
*.safetensors
*.h5
*.hdf5
!outputs/models/E0_reference_cnn_seed42_attempt2.pt
!outputs/models/E1_mobilenetv2_frozen_seed42.pt
!outputs/models/E2_mobilenetv2_finetuned_seed42.pt

